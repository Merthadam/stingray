{
  "name": "stingray",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A local-first workspace for coding agents",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:ui": "vite --host 127.0.0.1 --port 5178 --strictPort",
    "prototype:home": "vite --host 127.0.0.1 --port 5180 --strictPort",
    "build": "tsc --noEmit && vite build && node scripts/build-electron.mjs",
    "start": "electron .",
    "package:mac": "npm run build && node scripts/package-mac.mjs",
    "test": "tsx --test tests/*.test.ts",
    "test:desktop": "node tests/desktop.mjs",
    "test:repo-map": "node tests/repo-map.mjs",
    "test:terminal-links": "node tests/terminal-links.mjs",
    "test:workspace-status": "node tests/workspace-status.mjs",
    "test:pull-requests": "node tests/pull-requests.mjs",
    "test:add-project": "node tests/add-project.mjs"
  },
  "dependencies": {
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "lucide-react": "^0.468.0",
    "node-pty": "1.1.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "electron": "45.2.3",
    "esbuild": "^0.28.2",
    "playwright": "^1.56.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0",
    "vite": "8.3.6"
  },
  "allowScripts": {
    "esbuild@0.28.2": true,
    "node-pty@1.1.0": true
  }
}
